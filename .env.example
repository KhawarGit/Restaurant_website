# ------------------------------------------------------------------
# KK Grove — environment variables
# Copy this file to `.env.local` for local dev, and add the same keys
# in Vercel → Project → Settings → Environment Variables for production.
# EVERYTHING HERE IS OPTIONAL — the app runs fully without any of it.
#
# Storage priority (see lib/db.ts): Supabase > Redis > local file/in-memory.
# Only fill in ONE tier — Supabase is recommended.
# ------------------------------------------------------------------

# --- 1) Supabase (recommended persistent storage) ---
# 1. Create a free project at https://supabase.com
# 2. Open the SQL Editor and run supabase/schema.sql from this repo
# 3. Project Settings → API Keys → copy the "Project URL" and the
#    SECRET key (starts with sb_secret_...) into these:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# ⚠️ SUPABASE_SECRET_KEY bypasses Row Level Security — keep it a server-only
# env var (no NEXT_PUBLIC_ prefix) and never expose it to the browser.
#
# The matching PUBLISHABLE key (sb_publishable_...) is safe for the browser,
# but this app calls Supabase only from server-side API routes, so it isn't
# used anywhere in the code. Uncomment it only if you add client-side
# Supabase calls later (e.g. Realtime subscriptions):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 2) Upstash / Vercel KV Redis (fallback, used only if Supabase is unset) ---
# Vercel → Storage tab → Marketplace → "Upstash for Redis" → Free plan →
# Connect to project (this injects the two vars below automatically).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or, if you created a database directly at upstash.com instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Automatic WhatsApp notifications (optional) ---
# If BOTH are set, reservations/orders are sent automatically via the
# WhatsApp Cloud API. If unset, the app falls back to click-to-send
# wa.me links shown in the manager dashboard (no config needed).
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
