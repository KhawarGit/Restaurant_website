# ------------------------------------------------------------------
# KK Grove — environment variables
# Copy this file to `.env.local` for local dev, and add the same keys
# in Vercel → Project → Settings → Environment Variables for production.
# EVERYTHING HERE IS OPTIONAL — the app runs fully without any of it.
# ------------------------------------------------------------------

# --- Persistent storage: Upstash / Vercel KV Redis (recommended on Vercel) ---
# If these are set, all data (orders, reservations, feedback, tables) is stored
# in Redis and persists durably. If unset, the app uses a local JSON file in
# dev and in-memory storage on serverless (fine for a demo, but resets).
#
# Get them free: Vercel → Storage → Upstash for Redis (Marketplace), OR
# create a database at https://upstash.com. Connecting it on Vercel injects
# KV_REST_API_URL / KV_REST_API_TOKEN automatically.
#
# The app accepts EITHER naming convention:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or, if you use Upstash directly:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Automatic WhatsApp notifications (optional) ---
# If BOTH are set, reservations/orders are sent automatically via the
# WhatsApp Cloud API. If unset, the app falls back to click-to-send
# wa.me links shown in the manager dashboard (no config needed).
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
